<?xml version="1.0" encoding="utf-8"?>
<!-- Écran 3 — Accueil / Espace personnel (même langage visuel que la maquette) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <ImageView
        android:layout_width="460dp"
        android:layout_height="460dp"
        android:layout_gravity="top|end"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_decor_circle"
        android:translationX="170dp"
        android:translationY="-190dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="40dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="330dp"
                android:layout_height="300dp"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:contentDescription="@string/cd_illustration"
                android:scaleType="fitCenter"
                android:src="@drawable/illus_welcome" />

            <TextView
                android:id="@+id/tvWelcome"
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/home_welcome" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/home_subtitle"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Zone affichant l'e-mail de l'utilisateur -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_info_card"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_email_label"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLogout"
                style="@style/Button.Primary"
                android:layout_marginTop="32dp"
                android:text="@string/btn_logout" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
