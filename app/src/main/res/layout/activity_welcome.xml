<?xml version="1.0" encoding="utf-8"?>
<!-- Écran d'accueil de la maquette (optionnel) : illustration + Connexion / Inscription -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <ImageView
        android:layout_width="460dp"
        android:layout_height="460dp"
        android:layout_gravity="top|end"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_decor_circle"
        android:translationX="170dp"
        android:translationY="-190dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="40dp"
            android:paddingEnd="32dp"
            android:paddingBottom="40dp">

            <ImageView
                android:layout_width="330dp"
                android:layout_height="300dp"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:contentDescription="@string/cd_illustration"
                android:scaleType="fitCenter"
                android:src="@drawable/illus_welcome" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/welcome_title"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/welcome_subtitle"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnWelcomeLogin"
                    style="@style/Button.Primary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/btn_login_short" />

                <TextView
                    android:id="@+id/btnWelcomeRegister"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/btn_register_short"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
